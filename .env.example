# =====================================================================
#  FinTrust Final · settings
#  On your laptop you do NOT need this file at all: the app works without it.
#  Create a .env (copy this file) only when you want real emails, or to
#  test the online database. Never upload .env to GitHub.
# =====================================================================

# ---- Email for sign-in codes, invitations and resets ----------------
#  console = printed in the VS Code terminal (default, best for testing)
#  gmail   = real emails from your Gmail (works on your laptop)
#  brevo   = real emails through Brevo (needed on Render's free plan)
EMAIL_MODE=console

# For EMAIL_MODE=gmail (App Password from https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# For EMAIL_MODE=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=FinTrust Bank IAM

# ---- Demo accounts (created on the FIRST start only) ----------------
# Your Gmail here makes the 5 demo accounts use you+access@gmail.com etc.,
# so every sign-in code arrives in YOUR inbox. Leave empty for
# @fintrustbank.example addresses (fine with EMAIL_MODE=console).
ADMIN_EMAIL=
# Password for all demo accounts (default on the laptop: Mumbai@2026)
DEMO_PASSWORD=

# Show sign-in codes and invitation links on screen (classroom demo
# without email). Never use this for real people.
DEMO_MODE=false

# ---- Online database (only for publishing) --------------------------
# Leave empty on your laptop. When set, the app uses Supabase instead
# of the data folder.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Blockchain anchoring of the audit trail (optional, free) -------
# Create the key with:  npm run wallet   (it writes this line for you)
# Sepolia TEST network only: the coins have no value. Keep the key secret.
ANCHOR_PRIVATE_KEY=

# ---- Server ----------------------------------------------------------
PORT=5000
# Your public address once published, e.g. https://fintrust-final.onrender.com
APP_BASE_URL=
